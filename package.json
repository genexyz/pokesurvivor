{
  "name": "pokesurvivor",
  "version": "1.0.0",
  "private": true,
  "description": "PokéSurvivor · Mystery Dungeon: a Pokémon bullet-heaven (HTML + Canvas 2D, no framework).",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node server/index.mjs --dev",
    "build": "node scripts/check_stages.js && node scripts/build.js && npm run build:pages",
    "build:force": "node scripts/check_stages.js && node scripts/build.js --force && npm run build:pages",
    "build:debug": "node scripts/build.js --expose && npm run build:pages",
    "build:pages": "node scripts/export_data.js && node scripts/py.js scripts/make_seo_pages.py",
    "start": "node server/index.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "node -e \"for (const d of ['dist', '.cache']) require('fs').rmSync(d, { recursive: true, force: true })\"",
    "data:pokedex": "node scripts/py.js scripts/fetch_pokedex.py",
    "data:sprites": "node scripts/py.js scripts/fetch_sprites.py",
    "data:credits": "node scripts/py.js scripts/fetch_credits.py",
    "data:hover": "node scripts/py.js scripts/hover_flags.py",
    "data:icons": "node scripts/py.js scripts/make_icons.py",
    "data:font": "node scripts/py.js scripts/make_font.py",
    "docker:build": "docker build -t pokesurvivor .",
    "docker:run": "docker run --rm -p 8080:80 --env-file .env -e BETTER_AUTH_URL=http://localhost:8080 pokesurvivor",
    "db:up": "docker compose -f docker-compose.dev.yml up -d",
    "check:stages": "node scripts/check_stages.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "javascript-obfuscator": "4.1.1",
    "prettier": "^3.9.10",
    "terser": "^5.31.0",
    "vite": "8.3.4"
  },
  "dependencies": {
    "better-auth": "^1.7.10",
    "pg": "^8.23.1",
    "ws": "^8.22.0"
  }
}
