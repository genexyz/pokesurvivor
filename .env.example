# Copia este archivo a .env (no se sube al repositorio) para probar en local.
# En Coolify, estas mismas variables van en Environment Variables del servicio.

# Postgres (en local: npm run db:up). Sin DATABASE_URL el juego va sin nube.
DATABASE_URL=postgres://pokesurvivor:pokesurvivor@localhost:5432/pokesurvivor

# Dirección pública del juego (en Coolify: https://survivor.preciostcg.com)
BETTER_AUTH_URL=http://localhost:3000
# Secreto largo al azar: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Cliente OAuth de Google (el mismo que precios-tcg). En Google Cloud Console,
# añade el origen y la URI de redirección: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Correos de las cuentas de moderación (ranking), separados por comas
ADMIN_EMAILS=
