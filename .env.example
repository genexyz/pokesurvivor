# Copy this file to .env (not committed) to test locally.
# On Coolify, these same variables go in the service's Environment Variables.

# Postgres (locally: npm run db:up). Without DATABASE_URL the game runs without the cloud.
DATABASE_URL=postgres://pokesurvivor:pokesurvivor@localhost:5432/pokesurvivor

# Public URL of the game (on Coolify: https://survivor.preciostcg.com)
BETTER_AUTH_URL=http://localhost:3000
# Long random secret: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Google OAuth client (the same one as precios-tcg). In Google Cloud Console,
# add the origin and the redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Emails of the moderator accounts (leaderboard), comma-separated
ADMIN_EMAILS=
